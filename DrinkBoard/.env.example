# 复制成 .env 后按需要改。不要把真口令交进仓库。
DRINKBOARD_DB=./data/drinkboard.sqlite3
DRINKBOARD_BACKUP_DIR=./data/backups
DRINKBOARD_DRINKS_FILE=./config/drinks.json
DRINKBOARD_ALLOWED_ORIGINS=http://127.0.0.1:8773,http://localhost:8773
DRINKBOARD_TRUST_PROXY=0
DRINKBOARD_RATE_LIMIT=1
DRINKBOARD_DOCS=1
DRINKBOARD_SEED_DEMO=0
DRINKBOARD_HOST=127.0.0.1
DRINKBOARD_PORT=8773
# 可选。留空则只有创建房间时发的局主口令能改酒单。
DRINKBOARD_ADMIN_TOKEN=
