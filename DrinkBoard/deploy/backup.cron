# 每天 4:05 热备份。装到 /etc/cron.d/drinkboard 时改成有用户的那一列。
# 5 4 * * * drinkboard bash -lc 'set -a; source /etc/drinkboard.env; set +a; /opt/drinkboard/.venv/bin/python /opt/drinkboard/scripts/backup.py >> /var/lib/drinkboard/backup.log 2>&1'
5 4 * * * drinkboard bash -lc 'set -a; source /etc/drinkboard.env; set +a; /opt/drinkboard/.venv/bin/python /opt/drinkboard/scripts/backup.py >> /var/lib/drinkboard/backup.log 2>&1'
